{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/resource-inventory.schema.json",
  "title": "DevCadence ResourceInventory",
  "description": "Deterministic, point-in-time snapshot of hardware, cognition endpoints, principal hosts, credential references and policy metadata (ADR-0014 §92, ADR-0018). Never a decision or recommendation itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "machine_fingerprint",
    "observed_at",
    "hardware"
  ],
  "$defs": {
    "credential_inventory_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "evidence"],
      "properties": {
        "ref": { "$ref": "devcadence:///credential-ref.schema.json" },
        "evidence": { "$ref": "devcadence:///auth-evidence.schema.json" }
      }
    },
    "cognition_endpoint_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locality",
        "health",
        "auth_status",
        "cost_class",
        "required_source_exposure"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["local_runtime", "authenticated_cli", "remote_api"] },
        "locality": { "enum": ["local", "remote_inference_local_tools", "remote"] },
        "health": {
          "enum": [
            "not_installed", "installed", "not_configured", "unhealthy",
            "unverified", "ready", "unsupported", "unknown"
          ]
        },
        "auth_status": {
          "enum": ["not_applicable", "authenticated", "unauthenticated", "expired", "unknown", "error"]
        },
        "cost_class": {
          "enum": ["local_compute", "subscription_included", "remote_economy", "remote_strong", "frontier_expensive", "unknown"]
        },
        "required_source_exposure": {
          "enum": ["local_only", "semantic_evidence_only", "focused_snippets", "selected_files", "tool_mediated_worktree", "unrestricted_authorized"]
        },
        "acceleration_verified": { "type": "boolean" },
        "acceleration_backend": {
          "type": ["string", "null"],
          "enum": ["cpu", "metal", "cuda", "rocm", "vulkan", "unknown", null]
        }
      }
    },
    "principal_host_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "installed"],
      "properties": {
        "host_id": { "enum": ["antigravity", "cursor", "vscode"] },
        "installed": { "type": "boolean" },
        "path": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "scope_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "reason"],
      "properties": {
        "scope": {
          "enum": [
            "can_execute_setup_plan",
            "has_any_viable_cognition_path",
            "can_run_local_inference",
            "local_model_available",
            "can_use_existing_authenticated_cli",
            "principal_host_available"
          ]
        },
        "status": {
          "enum": ["ready", "not_ready", "unavailable", "unknown"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "machine_profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "machine_fingerprint", "observed_at", "probe_depth"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "machine_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "observed_at": { "type": "string", "format": "date-time" },
        "probe_depth": { "enum": ["inventory", "health", "inference"] }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "inventory_id": { "type": "string", "minLength": 1 },
    "machine_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os_family", "arch", "logical_cores"],
      "properties": {
        "os_family": { "enum": ["linux", "darwin", "windows", "unknown"] },
        "arch": { "type": "string", "minLength": 1 },
        "logical_cores": { "type": "integer", "minimum": 0 },
        "total_memory_bytes": { "type": "integer", "minimum": 0 },
        "accelerator_backends": {
          "type": "array",
          "items": { "enum": ["cpu", "metal", "cuda", "rocm", "vulkan", "unknown"] }
        }
      }
    },
    "profile": { "$ref": "#/$defs/machine_profile_ref" },
    "cognition_endpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/cognition_endpoint_summary" }
    },
    "principal_hosts": {
      "type": "array",
      "items": { "$ref": "#/$defs/principal_host_summary" }
    },
    "credentials": {
      "type": "array",
      "items": { "$ref": "#/$defs/credential_inventory_entry" }
    },
    "readiness": {
      "type": "array",
      "items": { "$ref": "#/$defs/scope_readiness" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_source_exposure", "max_cost_class"],
      "properties": {
        "max_source_exposure": {
          "enum": ["local_only", "semantic_evidence_only", "focused_snippets", "selected_files", "tool_mediated_worktree", "unrestricted_authorized"]
        },
        "max_cost_class": {
          "enum": ["local_compute", "subscription_included", "remote_economy", "remote_strong", "frontier_expensive", "unknown"]
        }
      }
    }
  }
}
