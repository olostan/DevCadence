{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/context-pack.schema.json",
  "title": "DevCadence ContextPack",
  "description": "Ephemeral compiled invocation input reproducible from a ContextManifest revision (PROTOCOLS §10B).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "manifest_id",
    "manifest_revision",
    "role_core",
    "execution_contract",
    "normative_clauses",
    "cognitive_state",
    "evidence_working_set",
    "ephemeral_tail",
    "token_accounting",
    "admitted_object_digests",
    "pack_digest",
    "coverage_summary",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_revision": {
      "type": "integer",
      "minimum": 1
    },
    "role_core": {
      "type": "string",
      "minLength": 1
    },
    "execution_contract": {
      "type": "string",
      "minLength": 1
    },
    "normative_clauses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cognitive_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypotheses",
        "active_todos",
        "intermediate_decisions",
        "open_questions",
        "evidence_dependencies"
      ],
      "properties": {
        "hypotheses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "active_todos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "intermediate_decisions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_dependencies": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence_working_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "lease_id",
          "evidence_kind",
          "source_revision",
          "worktree_id",
          "file_path",
          "locator",
          "content_digest",
          "acquisition_question",
          "acquisition_reason",
          "content",
          "token_count",
          "accounting_method",
          "status",
          "acquired_at"
        ],
        "properties": {
          "schema_version": { "const": "1.0" },
          "lease_id": { "type": "string", "minLength": 1 },
          "evidence_kind": {
            "enum": [
              "source_snippet",
              "diff_hunk",
              "log_excerpt",
              "symbol_signature",
              "normative_clause"
            ]
          },
          "source_revision": { "type": "string", "minLength": 1 },
          "worktree_id": { "type": "string", "minLength": 1 },
          "file_path": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "acquisition_question": { "type": "string", "minLength": 1 },
          "acquisition_reason": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "token_count": { "type": "integer", "minimum": 1 },
          "accounting_method": {
            "enum": [
              "exact_bpe",
              "provider_api",
              "approximate_estimate"
            ]
          },
          "status": {
            "enum": [
              "active",
              "released",
              "invalidated"
            ]
          },
          "acquired_at": { "type": "string", "minLength": 1 },
          "expires_at": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ephemeral_tail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recent_tool_exchanges",
        "current_action"
      ],
      "properties": {
        "recent_tool_exchanges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "candidate_diff_manifest": { "type": "string" },
        "validation_summaries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "current_action": { "type": "string", "minLength": 1 }
      }
    },
    "token_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_tokens",
        "contract_tokens",
        "normative_tokens",
        "state_tokens",
        "evidence_tokens",
        "tail_tokens",
        "output_reserve_tokens",
        "total_resident_tokens",
        "accounting_method"
      ],
      "properties": {
        "role_tokens": { "type": "integer", "minimum": 0 },
        "contract_tokens": { "type": "integer", "minimum": 0 },
        "normative_tokens": { "type": "integer", "minimum": 0 },
        "state_tokens": { "type": "integer", "minimum": 0 },
        "evidence_tokens": { "type": "integer", "minimum": 0 },
        "tail_tokens": { "type": "integer", "minimum": 0 },
        "output_reserve_tokens": { "type": "integer", "minimum": 0 },
        "total_resident_tokens": { "type": "integer", "minimum": 0 },
        "accounting_method": {
          "enum": [
            "exact_bpe",
            "provider_api",
            "approximate_estimate"
          ]
        }
      }
    },
    "admitted_object_digests": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "pack_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "coverage_summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "context_unfit",
        "rejected"
      ]
    }
  }
}
