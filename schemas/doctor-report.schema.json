{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/doctor-report.schema.json",
  "title": "DevCadence DoctorReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "machine_fingerprint",
    "observed_at",
    "evaluation_scope",
    "readiness",
    "findings"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "report_id": { "type": "string" },
    "machine_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "readiness": {
      "enum": ["READY", "READY_WITH_REDUCED_CAPABILITY", "PARTIALLY_READY", "ACTION_REQUIRED"]
    },
    "evaluation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_roles", "evidence_status"],
      "properties": {
        "target_profile": {
          "enum": ["local-heavy", "hybrid-thin", "cloud-cognition", "offline", "custom"]
        },
        "required_roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_status": {
          "enum": ["live", "refreshed_health", "stale_inference_retained"]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "code", "title", "detail"],
        "properties": {
          "category": {
            "enum": ["environment", "hardware", "runtime", "cognition", "auth", "state"]
          },
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "remediation": { "type": ["string", "null"] }
        }
      }
    },
    "recommended_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "alternatives"],
      "properties": {
        "selected_profile": {
          "enum": ["local-heavy", "hybrid-thin", "cloud-cognition", "offline", "custom"]
        },
        "rationale": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "eligible", "reasons"],
            "properties": {
              "profile": {
                "enum": ["local-heavy", "hybrid-thin", "cloud-cognition", "offline", "custom"]
              },
              "eligible": { "type": "boolean" },
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "missing_prerequisites": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unknowns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "discovered_endpoints": {
      "description": "uniqueItems rejects byte-identical duplicate entries only. Rejecting two entries that share an id but differ in content is a stricter, Go-only invariant (DoctorReport.Validate), because JSON Schema cannot express 'unique keyed by id, equal on the rest' without restructuring this array into a keyed object.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "locality",
          "health",
          "auth_status",
          "cost_class",
          "required_source_exposure"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "local_runtime",
              "authenticated_cli",
              "remote_api"
            ]
          },
          "locality": {
            "enum": [
              "local",
              "remote_inference_local_tools",
              "remote"
            ]
          },
          "health": {
            "enum": [
              "not_installed",
              "installed",
              "not_configured",
              "unhealthy",
              "unverified",
              "ready",
              "unsupported",
              "unknown"
            ]
          },
          "auth_status": {
            "enum": [
              "not_applicable",
              "authenticated",
              "unauthenticated",
              "expired",
              "unknown",
              "error"
            ]
          },
          "cost_class": {
            "enum": [
              "local_compute",
              "subscription_included",
              "remote_economy",
              "remote_strong",
              "frontier_expensive",
              "unknown"
            ]
          },
          "required_source_exposure": {
            "enum": [
              "local_only",
              "semantic_evidence_only",
              "focused_snippets",
              "selected_files",
              "tool_mediated_worktree",
              "unrestricted_authorized"
            ]
          },
          "acceleration_verified": {
            "type": "boolean"
          },
          "acceleration_backend": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "cpu",
              "metal",
              "cuda",
              "rocm",
              "vulkan",
              "unknown",
              null
            ]
          },
          "credential_ref": { "type": "string" }
        },
        "allOf": [
          {
            "description": "Verified local acceleration is impossible for an endpoint whose inference is not local.",
            "if": {
              "properties": {
                "acceleration_verified": {
                  "const": true
                }
              },
              "required": [
                "acceleration_verified"
              ]
            },
            "then": {
              "properties": {
                "locality": {
                  "const": "local"
                }
              }
            }
          },
          {
            "description": "Local runtimes must have locality local.",
            "if": {
              "properties": {
                "kind": { "const": "local_runtime" }
              }
            },
            "then": {
              "properties": {
                "locality": { "const": "local" }
              }
            }
          },
          {
            "description": "Remote APIs cannot be local (mirrors CognitionEndpointSummary.Validate's kind=remote_api rule; independent-review follow-up on WP-M3B-5, round-3 finding 3b).",
            "if": {
              "properties": {
                "kind": { "const": "remote_api" }
              }
            },
            "then": {
              "properties": {
                "locality": { "not": { "const": "local" } }
              }
            }
          },
          {
            "description": "Local runtimes have no account, so their auth_status must be not_applicable or unknown (mirrors CognitionEndpointSummary.Validate's kind=local_runtime rule; independent-review follow-up on WP-M3B-5, round-3 finding 3b).",
            "if": {
              "properties": {
                "kind": { "const": "local_runtime" }
              }
            },
            "then": {
              "properties": {
                "auth_status": { "enum": ["not_applicable", "unknown"] }
              }
            }
          }
        ]
      }
    },
    "principal_hosts": {
      "description": "uniqueItems rejects byte-identical duplicate entries only; duplicate host_id with differing content is a Go-only invariant (DoctorReport.Validate), same rationale as discovered_endpoints.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host_id", "installed"],
        "properties": {
          "host_id": { "enum": ["antigravity", "cursor", "vscode"] },
          "installed": { "type": "boolean" },
          "path": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "scope_readiness": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "status", "reason"],
        "properties": {
          "scope": {
            "enum": [
              "can_execute_setup_plan",
              "has_any_viable_cognition_path",
              "can_run_local_inference",
              "local_model_available",
              "can_use_existing_authenticated_cli",
              "principal_host_available"
            ]
          },
          "status": {
            "enum": ["ready", "not_ready", "unavailable", "unknown"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        { "contains": { "properties": { "scope": { "const": "can_execute_setup_plan" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "scope": { "const": "has_any_viable_cognition_path" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "scope": { "const": "can_run_local_inference" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "scope": { "const": "local_model_available" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "scope": { "const": "can_use_existing_authenticated_cli" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "scope": { "const": "principal_host_available" } } }, "minContains": 0, "maxContains": 1 }
      ]
    },
    "resource_inventory": { "$ref": "devcadence:///resource-inventory.schema.json" }
  }
}
