{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/review-invocation-intent.schema.json",
  "title": "DevCadence ReviewInvocationIntent",
  "description": "Pre-invocation intent record written before calling a reviewer model, guarding against concurrent duplicate reviews (WP-M5-R2 Part A).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "project_id",
    "task_id",
    "attempt_id",
    "work_package_id",
    "dimension",
    "invocation_id",
    "candidate_commit",
    "invocation_number",
    "reviewer_basis",
    "independence_basis",
    "endpoint_binding_digest",
    "started_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^:]+$"
    },
    "work_package_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "dimension": {
      "enum": [
        "correctness",
        "architecture",
        "invariants",
        "security",
        "test_adequacy",
        "concurrency",
        "performance",
        "maintainability",
        "other"
      ]
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "candidate_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "invocation_number": {
      "type": "integer",
      "const": 1
    },
    "reviewer_basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint_id": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "model_revision": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model_family": {
          "type": "string"
        },
        "account_ref": {
          "type": "string"
        }
      }
    },
    "independence_basis": {
      "enum": [
        "endpoint_model",
        "model_family_account"
      ]
    },
    "endpoint_binding_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
