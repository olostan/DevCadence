{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadience/schemas/engineering-work-package.schema.json",
  "title": "DevCadience EngineeringWorkPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "work_package_id", "task_id", "version", "project_id",
    "project_state_revision", "base_commit", "change_class", "objective",
    "rationale", "architectural_intent", "assumptions", "scope", "guidance",
    "acceptance_criteria", "validation_requirements", "escalation_conditions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_package_id": {"type": "string"},
    "task_id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string"},
    "project_state_revision": {"type": "string"},
    "base_commit": {"type": "string", "minLength": 7},
    "change_class": {"enum": ["local", "systemic", "architectural"]},
    "objective": {"type": "string", "minLength": 1},
    "rationale": {"type": "string"},
    "architectural_intent": {"type": "string"},
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status", "material"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "status": {"enum": ["verified", "accepted_risk", "unverified"]},
          "material": {"type": "boolean"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "decision_refs": {"type": "array", "items": {"type": "string"}},
    "invariant_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "expected_components": {"type": "array", "items": {"type": "string"}},
        "prohibited_components": {"type": "array", "items": {"type": "string"}}
      }
    },
    "implementation_strategy": {"type": ["string", "null"]},
    "interfaces": {"type": "array", "items": {"type": "string"}},
    "pseudocode": {"type": "array", "items": {"type": "string"}},
    "code_snippets": {"type": "array", "items": {"type": "string"}},
    "repository_anchors": {"type": "array", "items": {"type": "string"}},
    "edge_cases": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "guidance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "strength", "statement"],
        "properties": {
          "id": {"type": "string"},
          "strength": {"enum": ["MUST", "SHOULD", "SUGGESTED", "LOCAL_DISCRETION"]},
          "statement": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "escalation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observability_requirements": {"type": "array", "items": {"type": "string"}},
    "migration": {"type": ["string", "null"]},
    "rollback": {"type": ["string", "null"]}
  }
}