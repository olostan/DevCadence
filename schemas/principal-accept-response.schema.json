{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/principal-accept-response.schema.json",
  "title": "DevCadence Principal accept response",
  "description": "Response of the accept tool (WP-M5-2): the same value for a Go and an MCP caller. state_revision is the prefix observed or committed and is omitted when the call was refused before any read. Acceptance is hard-disabled, so this response always carries an error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_refs",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "state_revision": {
      "type": "string",
      "pattern": "^ps_([0-9]{9}|[1-9][0-9]{9,})$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$"
      }
    },
    "error": {
      "$ref": "devcadence:///principal-semantic-error.schema.json"
    }
  }
}
