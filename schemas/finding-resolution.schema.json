{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/finding-resolution.schema.json",
  "title": "DevCadence FindingResolution",
  "description": "Implementer response (fix attempted or challenge) to an accepted review finding (WP-M3C-5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resolution_id",
    "project_id",
    "campaign_id",
    "finding_id",
    "disposition_id",
    "contract_revision",
    "attempt_no",
    "kind",
    "target_candidate_commit",
    "rationale",
    "evidence_refs",
    "producer",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "resolution_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "disposition_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "fix_attempted",
        "challenge"
      ]
    },
    "target_candidate_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "resolved_candidate_commit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "invocation_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "role": {
          "const": "implementer"
        },
        "lineage_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "endpoint_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fix_attempted"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "resolved_candidate_commit"
        ],
        "properties": {
          "resolved_candidate_commit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "resolved_candidate_commit": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "producer": {
            "properties": {
              "actor_id": {
                "const": "act-producer-1"
              },
              "lineage_actor_ids": {
                "contains": {
                  "const": "act-producer-1"
                }
              }
            },
            "required": [
              "actor_id",
              "lineage_actor_ids"
            ]
          }
        }
      },
      "then": false
    }
  ]
}
