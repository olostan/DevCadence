{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadience/schemas/project-state.schema.json",
  "title": "DevCadience ProjectState",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "state_revision", "generated_at", "git", "milestone", "tasks", "validation", "risks", "decisions_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "state_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "event_high_watermark": {"type": ["string", "null"]},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_commit"],
      "properties": {
        "accepted_commit": {"type": "string", "minLength": 7},
        "branch": {"type": ["string", "null"]},
        "dirty": {"type": "boolean", "default": false}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vision_ref": {"type": ["string", "null"]},
        "current_outcome": {"type": ["string", "null"]}
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "status": {"type": "string"},
        "completed_tasks": {"type": "integer", "minimum": 0},
        "total_tasks": {"type": "integer", "minimum": 0}
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "responsibility": {"type": ["string", "null"]},
          "status": {"type": "string"},
          "contract_state": {"enum": ["stable", "evolving", "deprecated", "unknown"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "running", "blocked", "awaiting_principal"],
      "properties": {
        "ready": {"type": "array", "items": {"type": "string"}},
        "running": {"type": "array", "items": {"type": "string"}},
        "blocked": {"type": "array", "items": {"type": "string"}},
        "awaiting_principal": {"type": "array", "items": {"type": "string"}}
      }
    },
    "active_invariants": {"type": "array", "items": {"type": "string"}},
    "active_decisions": {"type": "array", "items": {"type": "string"}},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["green", "yellow", "red", "unknown"]},
        "accepted_commit_verified": {"type": "boolean"},
        "last_full_validation_id": {"type": ["string", "null"]}
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["green", "watch", "refactor_due", "unknown"]},
        "last_report_id": {"type": ["string", "null"]},
        "known_debt": {"type": "array", "items": {"type": "string"}}
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "statement"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "statement": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "authority"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "authority": {"enum": ["policy", "principal", "consultant", "human"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recent_semantic_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "summary"],
        "properties": {
          "task_id": {"type": "string"},
          "commit": {"type": ["string", "null"]},
          "summary": {"type": "string"}
        }
      }
    },
    "capabilities": {"type": "object"}
  }
}