{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadience/schemas/project-state.schema.json",
  "title": "DevCadience ProjectState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "state_revision",
    "generated_at",
    "git",
    "milestone",
    "tasks",
    "validation",
    "risks",
    "decisions_required"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "state_revision": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_high_watermark": {
      "type": [
        "string",
        "null"
      ]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_commit"
      ],
      "properties": {
        "accepted_commit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 7
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vision_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_outcome": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "completed_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "total_tasks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "responsibility": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "contract_state": {
            "enum": [
              "stable",
              "evolving",
              "deprecated",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "running",
        "blocked",
        "awaiting_principal"
      ],
      "properties": {
        "ready": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "running": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "awaiting_principal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "active_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "green",
            "yellow",
            "red",
            "unknown"
          ]
        },
        "accepted_commit_verified": {
          "type": "boolean"
        },
        "last_full_validation_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "green",
            "watch",
            "refactor_due",
            "unknown"
          ]
        },
        "last_report_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "known_debt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "statement": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "authority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "authority": {
            "enum": [
              "policy",
              "principal",
              "consultant",
              "human"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "recent_semantic_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "summary"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cognition": {
          "description": "Compact projection of discovered cognition capability (ADR-0011, ADR-0013). It carries endpoint identity, usability, cost and exposure plus the freshness metadata needed to tell whether it still describes the machine in front of the reader. Capability grades, probe signals, measurements and machine inventory stay in the MachineCapabilityProfile, retrievable by profile_ref.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessment"
          ],
          "properties": {
            "assessment": {
              "enum": [
                "ready",
                "ready_with_reduced_capability",
                "model_cognition_unavailable",
                "partially_ready",
                "unknown"
              ]
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "machine_fingerprint": {
              "type": [
                "string",
                "null"
              ]
            },
            "profile_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "endpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "locality",
                  "health",
                  "auth_status",
                  "cost_class",
                  "required_source_exposure"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "local_runtime",
                      "authenticated_cli",
                      "remote_api"
                    ]
                  },
                  "locality": {
                    "enum": [
                      "local",
                      "remote_inference_local_tools",
                      "remote"
                    ]
                  },
                  "health": {
                    "enum": [
                      "not_installed",
                      "installed",
                      "not_configured",
                      "unhealthy",
                      "unverified",
                      "ready",
                      "unsupported",
                      "unknown"
                    ]
                  },
                  "auth_status": {
                    "enum": [
                      "not_applicable",
                      "authenticated",
                      "unauthenticated",
                      "expired",
                      "unknown",
                      "error"
                    ]
                  },
                  "cost_class": {
                    "enum": [
                      "local_compute",
                      "subscription_included",
                      "remote_economy",
                      "remote_strong",
                      "frontier_expensive",
                      "unknown"
                    ]
                  },
                  "required_source_exposure": {
                    "enum": [
                      "local_only",
                      "semantic_evidence_only",
                      "focused_snippets",
                      "selected_files",
                      "tool_mediated_worktree",
                      "unrestricted_authorized"
                    ]
                  },
                  "acceleration_verified": {
                    "type": "boolean"
                  },
                  "acceleration_backend": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "cpu",
                      "metal",
                      "cuda",
                      "rocm",
                      "vulkan",
                      "unknown",
                      null
                    ]
                  }
                },
                "allOf": [
                  {
                    "description": "Verified local acceleration is impossible for an endpoint whose inference is not local.",
                    "if": {
                      "properties": {
                        "acceleration_verified": {
                          "const": true
                        }
                      },
                      "required": [
                        "acceleration_verified"
                      ]
                    },
                    "then": {
                      "properties": {
                        "locality": {
                          "const": "local"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "local_models": {
          "deprecated": true,
          "description": "Deprecated M1 representation, superseded by `cognition` (ADR-0013 §4). Retained so ProjectState documents written before M3A remain readable under strict decoding (DCI-092, DCI-093). Never written by current builds.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "available"
            ],
            "properties": {
              "profile": {
                "type": "string"
              },
              "runtime": {
                "type": "string"
              },
              "available": {
                "type": "boolean"
              }
            }
          }
        },
        "consultants": {
          "deprecated": true,
          "description": "Deprecated M1 representation, superseded by `cognition` (ADR-0013 §4). Consultant selection is an M6 policy over discovered endpoints, not a separate capability list. Never written by current builds.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "available"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "available": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problem_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "problem_model_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "ambiguity_ledger_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "open_material_ambiguities": {
          "type": "integer",
          "minimum": 0
        },
        "awaiting_human_ambiguities": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_requirements": {
          "type": "integer",
          "minimum": 0
        },
        "proposed_requirements": {
          "type": "integer",
          "minimum": 0
        },
        "material_assumptions_unverified": {
          "type": "integer",
          "minimum": 0
        },
        "active_product_decisions": {
          "type": "integer",
          "minimum": 0
        },
        "specification_readiness_verdict": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "not_ready",
            "ready_for_architecture",
            "ready_with_explicit_risks",
            null
          ]
        },
        "specification_readiness_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_question_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "campaign_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "broad_review",
            "adjudication",
            "repair",
            "focused_revalidation",
            "closure_review",
            "frozen",
            "reopened",
            "escalated",
            null
          ]
        },
        "repair_round": {
          "type": "integer",
          "minimum": 0
        },
        "max_repair_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "required_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "completed_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "blocking_findings_open": {
          "type": "integer",
          "minimum": 0
        },
        "material_findings_unadjudicated": {
          "type": "integer",
          "minimum": 0
        },
        "fix_now_findings": {
          "type": "integer",
          "minimum": 0
        },
        "deferred_findings": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_findings": {
          "type": "integer",
          "minimum": 0
        },
        "opportunistic_findings": {
          "type": "integer",
          "minimum": 0
        },
        "closure_threshold": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "critical",
            null
          ]
        },
        "residual_risk_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "closure_decision_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
