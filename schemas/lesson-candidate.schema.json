{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadience/schemas/lesson-candidate.schema.json",
  "title": "DevCadience LessonCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lesson_candidate_id", "scope", "type", "observation", "trajectory_refs", "proposed_change", "evaluation_plan", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "lesson_candidate_id": {"type": "string"},
    "scope": {"enum": ["task", "project", "language_framework", "organization", "global"]},
    "type": {"enum": ["project_invariant", "engineering_skill", "routing", "prompt", "test_heuristic", "review_rule", "escalation_rule", "task_decomposition", "architecture", "other"]},
    "observation": {"type": "string"},
    "trajectory_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "proposed_change": {"type": "string"},
    "expected_benefit": {"type": ["string", "null"]},
    "possible_counterexamples": {"type": "array", "items": {"type": "string"}},
    "conflict_refs": {"type": "array", "items": {"type": "string"}},
    "evaluation_plan": {"type": "string"},
    "promotion_authority": {"enum": ["policy", "principal", "human"]},
    "rollback_plan": {"type": ["string", "null"]},
    "status": {"enum": ["proposed", "evidence_gathering", "evaluation_ready", "evaluating", "needs_revision", "approved", "promoted", "monitoring", "stable", "rejected", "rolled_back"]}
  }
}