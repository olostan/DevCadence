{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/credential-ref.schema.json",
  "title": "DevCadence CredentialRef",
  "description": "Opaque reference to an authorization mechanism. Provider-neutral and free of secret custody.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref_id",
    "kind",
    "locator"
  ],
  "properties": {
    "ref_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_\\-:]+$"
    },
    "kind": {
      "enum": [
        "env_var",
        "cli_session",
        "keychain_ref"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "env_var" } }
      },
      "then": {
        "properties": {
          "locator": {
            "maxLength": 128,
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "cli_session" } }
      },
      "then": {
        "properties": {
          "locator": {
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_\\-:]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "keychain_ref" } }
      },
      "then": {
        "properties": {
          "locator": {
            "maxLength": 256,
            "pattern": "^[a-zA-Z0-9_\\-\\./:]+$"
          }
        }
      }
    }
  ]
}
