{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/credential-ref.schema.json",
  "title": "DevCadence CredentialRef",
  "description": "Opaque reference to an authorization mechanism. Provider-neutral and free of secret custody.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ref_id",
    "kind",
    "locator"
  ],
  "$defs": {
    "noSecretLike": {
      "description": "Mirrors internal/protocol.LooksLikeSecret's prefix/keyword checks exactly (see that function's doc comment) — kept in sync by TestSchemaSecretPatternParity.",
      "not": {
        "anyOf": [
          { "pattern": "(?i)^sk-" },
          { "pattern": "(?i)^sk_" },
          { "pattern": "(?i)^pat_" },
          { "pattern": "(?i)^ghp_" },
          { "pattern": "(?i)^gho_" },
          { "pattern": "(?i)^ghu_" },
          { "pattern": "(?i)^ghs_" },
          { "pattern": "(?i)^ghr_" },
          { "pattern": "(?i)^github_pat_" },
          { "pattern": "(?i)^bearer " },
          { "pattern": "(?i)^xoxb-" },
          { "pattern": "(?i)^xoxp-" },
          { "pattern": "(?i)^glpat-" },
          { "pattern": "(?i)^npm_" },
          { "pattern": "(?i)^aiza" },
          { "pattern": "^AKIA" },
          { "pattern": "^ASIA" },
          { "pattern": "(?i)secret=" },
          { "pattern": "(?i)token=" },
          { "pattern": "(?i)password=" },
          { "pattern": "(?i)api_key=" },
          { "pattern": "(?i)apikey=" }
        ]
      }
    }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "ref_id": {
      "allOf": [
        { "$ref": "#/$defs/noSecretLike" },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-:]+$"
        }
      ]
    },
    "kind": {
      "enum": [
        "env_var",
        "cli_session",
        "keychain_ref"
      ]
    },
    "locator": {
      "allOf": [
        { "$ref": "#/$defs/noSecretLike" },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "env_var" } }
      },
      "then": {
        "properties": {
          "locator": {
            "allOf": [
              { "$ref": "#/$defs/noSecretLike" },
              {
                "maxLength": 128,
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "cli_session" } }
      },
      "then": {
        "properties": {
          "locator": {
            "allOf": [
              { "$ref": "#/$defs/noSecretLike" },
              {
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9_\\-:]+$"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "keychain_ref" } }
      },
      "then": {
        "properties": {
          "locator": {
            "allOf": [
              { "$ref": "#/$defs/noSecretLike" },
              {
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9_\\-/:]+(\\.[a-zA-Z0-9_\\-/:]+)*$"
              }
            ]
          }
        }
      }
    }
  ]
}
