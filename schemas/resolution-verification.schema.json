{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/resolution-verification.schema.json",
  "title": "DevCadence ResolutionVerification",
  "description": "Independent verification judgment over a finding resolution attempt (WP-M3C-5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id",
    "project_id",
    "campaign_id",
    "finding_id",
    "resolution_id",
    "contract_revision",
    "verified_candidate_commit",
    "outcome",
    "rationale",
    "evidence_refs",
    "verifier",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "verification_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "resolution_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "verified_candidate_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "outcome": {
      "enum": [
        "verified_fixed",
        "verified_dismissed",
        "not_resolved",
        "re_adjudication_required"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "invocation_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "role": {
          "const": "verifier"
        },
        "lineage_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "endpoint_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
