{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/principal-project-state-response.schema.json",
  "title": "DevCadence Principal project_state response",
  "description": "Response of the project_state tool (WP-M5-2): the same value for a Go and an MCP caller. state_revision is the prefix observed or committed and is omitted when the call was refused before any read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "state_revision": {
      "type": "string",
      "pattern": "^ps_([0-9]{9}|[1-9][0-9]{9,})$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$"
      }
    },
    "error": {
      "$ref": "devcadence:///principal-semantic-error.schema.json"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus",
        "source_revision"
      ],
      "properties": {
        "focus": {
          "enum": [
            "project",
            "task",
            "discovery"
          ]
        },
        "source_revision": {
          "type": "string",
          "pattern": "^ps_([0-9]{9}|[1-9][0-9]{9,})$"
        },
        "project_state": {
          "$ref": "devcadence:///project-state.schema.json"
        },
        "task": {
          "$ref": "#/$defs/taskStatus"
        },
        "discovery": {
          "type": "object"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "discovery_analysis": {
          "$ref": "#/$defs/discoveryAnalysis"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ],
  "$defs": {
    "taskStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "alias",
        "state",
        "attempt_ids",
        "has_more_attempts"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$"
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "work_package": {
          "$ref": "devcadence:///principal-work-package-ref.schema.json"
        },
        "candidate": {
          "$ref": "devcadence:///principal-candidate-ref.schema.json"
        },
        "block_reason": {
          "type": "string"
        },
        "attempt_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$"
          }
        },
        "has_more_attempts": {
          "type": "boolean"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_commit",
        "dirty",
        "drifted",
        "changed_paths",
        "refresh_required"
      ],
      "properties": {
        "head_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "accepted_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "drifted": {
          "type": "boolean"
        },
        "changed_paths": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "refresh_required": {
          "type": "boolean"
        }
      }
    },
    "discoveryAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read-only reconstruction of discovery from durable records (WP-M5-3 read side). positive_readiness is derived, never trusted from a recorded verdict, and is false while any blocker remains.",
      "required": [
        "open_questions",
        "decision_statuses",
        "violations",
        "blockers",
        "positive_readiness"
      ],
      "properties": {
        "problem_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "problem_model_revision": {
          "type": "integer",
          "minimum": 1
        },
        "ambiguity_ledger_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ambiguity_ledger_revision": {
          "type": "integer",
          "minimum": 1
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "resolution_authority",
              "architectural_impact"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "resolution_authority": {
                "enum": [
                  "human",
                  "repository_tool",
                  "external_research",
                  "experiment",
                  "consultant",
                  "principal"
                ]
              },
              "architectural_impact": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              }
            }
          }
        },
        "decision_statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision_id",
              "status"
            ],
            "properties": {
              "decision_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "status": {
                "enum": [
                  "confirmed",
                  "superseded",
                  "withdrawn"
                ]
              }
            }
          }
        },
        "recorded_readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "current"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "verdict": {
              "enum": [
                "not_ready",
                "ready_for_architecture",
                "ready_with_explicit_risks"
              ]
            },
            "current": {
              "type": "boolean"
            }
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "subject"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "positive_readiness": {
          "type": "boolean"
        }
      }
    }
  }
}
