{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/principal-project-state-response.schema.json",
  "title": "DevCadence Principal project_state response",
  "description": "Response of the project_state tool (WP-M5-2): the same value for a Go and an MCP caller. state_revision is the prefix observed or committed and is omitted when the call was refused before any read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "state_revision": {
      "type": "string",
      "pattern": "^ps_([0-9]{9}|[1-9][0-9]{9,})$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$"
      }
    },
    "error": {
      "$ref": "devcadence:///principal-semantic-error.schema.json"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus",
        "source_revision"
      ],
      "properties": {
        "focus": {
          "enum": [
            "project",
            "task",
            "discovery"
          ]
        },
        "source_revision": {
          "type": "string",
          "pattern": "^ps_([0-9]{9}|[1-9][0-9]{9,})$"
        },
        "project_state": {
          "$ref": "devcadence:///project-state.schema.json"
        },
        "task": {
          "$ref": "#/$defs/taskStatus"
        },
        "discovery": {
          "type": "object"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ],
  "$defs": {
    "taskStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "alias",
        "state",
        "attempt_ids",
        "has_more_attempts"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$"
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "work_package": {
          "$ref": "devcadence:///principal-work-package-ref.schema.json"
        },
        "candidate": {
          "$ref": "devcadence:///principal-candidate-ref.schema.json"
        },
        "block_reason": {
          "type": "string"
        },
        "attempt_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$"
          }
        },
        "has_more_attempts": {
          "type": "boolean"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_commit",
        "dirty",
        "drifted",
        "changed_paths",
        "refresh_required"
      ],
      "properties": {
        "head_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "accepted_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "drifted": {
          "type": "boolean"
        },
        "changed_paths": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "refresh_required": {
          "type": "boolean"
        }
      }
    }
  }
}
