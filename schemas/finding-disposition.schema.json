{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadience/schemas/finding-disposition.schema.json",
  "title": "DevCadience FindingDisposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disposition_id",
    "campaign_id",
    "finding_id",
    "severity",
    "materiality",
    "disposition",
    "rationale",
    "decided_by",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "disposition_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "materiality": {
      "enum": [
        "blocking",
        "material_non_blocking",
        "opportunistic"
      ]
    },
    "disposition": {
      "enum": [
        "fix_now",
        "reject",
        "defer",
        "human_decision",
        "duplicate"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "why_now": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicate_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "deferred_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "reconsideration_trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "accepted_risk_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "decided_by": {
      "enum": [
        "principal",
        "human"
      ]
    },
    "repair_guidance": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "fix_now"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "required": [
          "why_now"
        ],
        "properties": {
          "why_now": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "duplicate"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "required": [
          "duplicate_of"
        ],
        "properties": {
          "duplicate_of": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "defer"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "required": [
          "deferred_target",
          "reconsideration_trigger"
        ],
        "properties": {
          "deferred_target": {
            "type": "string",
            "minLength": 1
          },
          "reconsideration_trigger": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
