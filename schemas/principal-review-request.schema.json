{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/principal-review-request.schema.json",
  "title": "DevCadence Principal review request",
  "description": "Strict request of the review tool (WP-M5-2). No actor, grant or policy: the caller comes from the launch binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "candidate",
    "dimensions"
  ],
  "properties": {
    "meta": {
      "$ref": "devcadence:///principal-call-meta.schema.json"
    },
    "candidate": {
      "$ref": "devcadence:///principal-candidate-ref.schema.json"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "correctness",
          "contract",
          "architecture",
          "security",
          "test_adequacy",
          "maintainability",
          "performance",
          "specification"
        ]
      }
    }
  }
}
