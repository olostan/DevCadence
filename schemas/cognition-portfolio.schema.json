{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/cognition-portfolio.schema.json",
  "title": "DevCadence CognitionPortfolio",
  "description": "Canonical routing configuration mapping engineering roles to endpoints, access channels, and budget pools (ADR-0018 §7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "portfolio_id",
    "revision",
    "created_at",
    "channels",
    "role_bindings",
    "budget_pools",
    "max_source_exposure"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "channel_id",
          "endpoint_id",
          "kind",
          "session_mode",
          "context_control",
          "prefix_cache",
          "supports_streaming",
          "supports_tools",
          "native_worktree_access",
          "max_concurrent_requests"
        ],
        "properties": {
          "schema_version": { "const": "1.0" },
          "channel_id": { "type": "string", "minLength": 1 },
          "endpoint_id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "direct_http_api",
              "cli_subprocess",
              "local_daemon_socket",
              "remote_agent_proxy"
            ]
          },
          "session_mode": {
            "enum": [
              "stateless_per_call",
              "persistent_session",
              "resumable_session"
            ]
          },
          "context_control": {
            "enum": [
              "exact_stateless",
              "append_only",
              "opaque_session"
            ]
          },
          "prefix_cache": {
            "enum": [
              "explicit",
              "implicit",
              "session_kv",
              "none"
            ]
          },
          "supports_streaming": { "type": "boolean" },
          "supports_tools": { "type": "boolean" },
          "native_worktree_access": { "type": "boolean" },
          "credential_ref_id": { "type": "string", "minLength": 1 },
          "max_concurrent_requests": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "role_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "endpoint_id",
          "channel_id",
          "budget_pool_id",
          "context_profile_id"
        ],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "endpoint_id": { "type": "string", "minLength": 1 },
          "channel_id": { "type": "string", "minLength": 1 },
          "budget_pool_id": { "type": "string", "minLength": 1 },
          "context_profile_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "budget_pools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "pool_id",
          "name",
          "regime",
          "unit",
          "hard_limit",
          "soft_alert_limit",
          "period",
          "allow_overage",
          "fallback_allowed_to_metered"
        ],
        "properties": {
          "schema_version": { "const": "1.0" },
          "pool_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "regime": {
            "enum": [
              "local_compute",
              "subscription_quota",
              "metered_api",
              "prepaid_credits",
              "enterprise_allocation",
              "unknown_custom"
            ]
          },
          "unit": {
            "enum": [
              "usd_cents",
              "token_credits",
              "tokens",
              "requests",
              "seconds"
            ]
          },
          "hard_limit": { "type": "integer", "minimum": 0 },
          "soft_alert_limit": { "type": "integer", "minimum": 0 },
          "period": {
            "enum": [
              "rolling_hour",
              "rolling_day",
              "billing_cycle",
              "per_attempt",
              "per_task"
            ]
          },
          "allow_overage": { "type": "boolean" },
          "fallback_allowed_to_metered": { "type": "boolean" }
        }
      }
    },
    "max_source_exposure": {
      "enum": [
        "local_only",
        "semantic_evidence_only",
        "focused_snippets",
        "selected_files",
        "tool_mediated_worktree",
        "unrestricted_authorized"
      ]
    }
  }
}
