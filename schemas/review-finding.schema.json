{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/review-finding.schema.json",
  "title": "DevCadence ReviewFinding",
  "description": "Normalized material finding with stable identity and durable reviewer provenance (WP-M3C-5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "project_id",
    "campaign_id",
    "candidate_commit",
    "work_package_id",
    "contract_revision",
    "severity",
    "materiality",
    "claim",
    "impact",
    "verification_method",
    "evidence_refs",
    "source_observations",
    "reviewer",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "candidate_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "work_package_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "materiality": {
      "enum": [
        "blocking",
        "material_non_blocking",
        "opportunistic"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "impact": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verification_method": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "why_now": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "source_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id",
          "finding_index"
        ],
        "properties": {
          "review_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "finding_index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "invocation_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "role": {
          "const": "reviewer"
        },
        "lineage_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "endpoint_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
