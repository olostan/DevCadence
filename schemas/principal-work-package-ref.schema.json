{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olostan/DevCadence/schemas/principal-work-package-ref.schema.json",
  "title": "DevCadence Principal WorkPackageRef",
  "description": "Exact Work Package version identity (WP-M5-1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "digest",
    "base_commit"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\p{Cc}]*\\S[^\\p{Cc}]*$",
      "description": "Work Package identifier."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    }
  }
}
